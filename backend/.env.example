# Backend service settings
APP_NAME=GridTMS Secure Backend
APP_ENV=local
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Supabase Postgres pooler URL. Use Project Settings -> Database -> Connection string -> Transaction pooler.
# IMPORTANT: pooler username usually looks like postgres.<project-id>
SUPABASE_DB_URL=postgresql://postgres.ntvjqhacuvcqdfpkwpgx:REPLACE_WITH_DB_PASSWORD@aws-1-us-west-2.pooler.supabase.com:5432/postgres

# Supabase Auth project settings
SUPABASE_URL=https://ntvjqhacuvcqdfpkwpgx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_UCkcr8z9sI96dTwx4TYbSw_9EjQSkub

# REQUIRED for backend account creation using Supabase Auth Admin API.
# Project Settings -> API -> Secret keys -> service_role/secret key.
# NEVER put this in frontend.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SECRET_SERVICE_ROLE_KEY

# Carrier verification.
# strict = user cannot create account or log in unless DOT/MC is verified.
REQUIRE_CARRIER_VERIFICATION=true
CARRIER_VERIFICATION_MODE=manual

# Optional external provider mode, if you buy/connect a real DOT/MC data API later.
DOT_PROVIDER_API_URL=
DOT_PROVIDER_API_KEY=
