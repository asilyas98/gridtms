# FastAPI
APP_ENV=local
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Supabase public project values
SUPABASE_URL=https://ntvjqhacuvcqdfpkwpgx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_UCkcr8z9sI96dTwx4TYbSw_9EjQSkub

# Also supported for Next.js-style naming; backend/settings.py reads these as fallback too.
NEXT_PUBLIC_SUPABASE_URL=https://ntvjqhacuvcqdfpkwpgx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_UCkcr8z9sI96dTwx4TYbSw_9EjQSkub

# REQUIRED PRIVATE SERVER VALUE:
# Get this from Supabase Project Settings -> API/Secrets or Project Settings -> API -> service_role.
# Do NOT put this in frontend code.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SUPABASE_SERVICE_ROLE_OR_SECRET_KEY

# REQUIRED PRIVATE POSTGRES VALUE:
# Get this from Supabase -> Connect -> Transaction pooler.
# Example:
# postgresql://postgres.ntvjqhacuvcqdfpkwpgx:YOUR_DB_PASSWORD@aws-1-us-west-2.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=postgresql://postgres.ntvjqhacuvcqdfpkwpgx:REPLACE_WITH_YOUR_DB_PASSWORD@aws-1-us-west-2.pooler.supabase.com:5432/postgres

# Business verification behavior
# manual = check Supabase verified_businesses table only
# provider = check table first, then call DOT_PROVIDER_API_URL
BUSINESS_VERIFICATION_MODE=manual
DOT_PROVIDER_API_URL=
DOT_PROVIDER_API_KEY=

# 2-step verification
# dev returns the OTP in API response for local testing.
# twilio sends SMS if TWILIO_* values are configured.
OTP_MODE=dev
OTP_EXPIRY_MINUTES=10
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# AI Chatbot
USE_AWS=false
AWS_REGION=us-east-1
BEDROCK_LLM_MODEL=us.amazon.nova-lite-v1:0

# Local demo login. Set DEMO_LOGIN_ENABLED=false before production.
DEMO_LOGIN_ENABLED=true
DEMO_USERNAME=demo
DEMO_PASSWORD=demo
DEMO_TOKEN=gridtms-demo-token
DEMO_BUSINESS_ID=00000000-0000-0000-0000-000000000001
